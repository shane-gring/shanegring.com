# macOS
.DS_Store

# Cloudflare Wrangler local dev artifacts
.wrangler/
node_modules/


# Secrets. tools/sync-beehiiv.mjs reads BEEHIIV_API_KEY from here. The
# deploy is `wrangler pages deploy .` from this directory, so a committed
# key would be served publicly.
.env

# Editor cruft
.vscode/
.idea/

# Logs
*.log

# Mobile review artifacts (screenshots + Playwright capture scripts)
screenshots/
scripts/

# Offer source copy and the pricing model. The deploy is `wrangler pages deploy .`
# from this directory, so anything committed here is served publicly and crawled
# (robots.txt allows all). pricing-model.md contains income targets, tax rates,
# subcontractor cost, and per-line margins. It must never reach the CDN.
docs/

# Wrangler local dev secrets (same contents as .env)
.dev.vars

# Git worktrees for branch work. The deploy is `wrangler pages deploy .`,
# which uploads everything not gitignored — an unignored worktree would ship
# a full copy of a branch site publicly and pollute functions/routes.json.
.worktrees/
