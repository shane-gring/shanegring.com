# Cloudflare Pages headers.
#
# Keep the Pages-hosted copies out of search. The canonical host is
# shanegring.com; shanegring-com.pages.dev serves the identical site, so without
# this it is a full duplicate competing with the canonical domain. Rules are
# scoped by full URL so the canonical host is untouched.
#
# This complements the hostname guard on the GTM snippet in every page's <head>
# (which keeps preview traffic out of GA4). That guard handles analytics; this
# handles indexing. They are separate problems and need separate fixes.

https://shanegring-com.pages.dev/*
  X-Robots-Tag: noindex

https://:version.shanegring-com.pages.dev/*
  X-Robots-Tag: noindex

# Note on caching, so nobody tries this again: Cloudflare Pages ignores
# Cache-Control set here for its own static assets. Setting max-age=60 on
# /styles.css was measured to have no effect — Pages still served
# max-age=14400. The desync between always-fresh HTML and a four-hour-old
# stylesheet is handled instead by versioning the asset URLs, which
# tools/version-assets.mjs does on every deploy.

# Fleet-internal records under /fleet/* are never for search, on any host —
# they are preview-deploy proof artifacts, not site pages. This is the header
# half of the noindex proof; each page also carries a robots meta tag.
/fleet/*
  X-Robots-Tag: noindex
